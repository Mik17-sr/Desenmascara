# Copia este archivo a .env.local para usar Supabase Realtime en lugar de consultar cada 3 s.
# Supabase > Project Settings > API: "Project URL" y la llave pública "anon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dirección de la API de Desenmascara
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
