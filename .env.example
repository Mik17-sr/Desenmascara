# 127.0.0.1 en lugar de localhost: en Windows, localhost prueba primero IPv6 y añade ~0,2 s por conexión.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
API_BASE_URL=http://127.0.0.1:8000
# Configura el token real únicamente en tu entorno local; nunca lo subas al repositorio.
TELEGRAM_BOT_TOKEN=
