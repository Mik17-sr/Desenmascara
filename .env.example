# 127.0.0.1 en lugar de localhost: en Windows, localhost prueba primero IPv6 y añade ~0,2 s por conexión.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=base
API_BASE_URL=http://127.0.0.1:8000
# Configura el token real únicamente en tu entorno local; nunca lo subas al repositorio.
TELEGRAM_BOT_TOKEN=
# Sin DATABASE_URL se usa SQLite local (desenmascara.db). Para Supabase:
# DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/postgres

# Secretos: `python scripts/setup_local.py` los genera en .env. No los compartas.
HMAC_SECRET=
ENCRYPTION_KEY=
BOT_API_SECRET=
ADMIN_API_KEY=

DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: consulta de enlaces peligrosos en Google Safe Browsing.
GOOGLE_SAFE_BROWSING_KEY=
